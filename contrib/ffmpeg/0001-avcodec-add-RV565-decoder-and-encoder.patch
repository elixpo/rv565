 @end table
 
+@section rv565
+
+RV565 video encoder.
+
+RV565 stores frames in the pixel format of a microcontroller display. Every
+keyframe interval starts with a keyframe; any other frame is a repeat when it
+equals the previous frame, otherwise the smaller of a keyframe and a delta
+(the XOR of the frame with the previous one), or a partial delta (the bands
+of lines that changed, each predicted from the previous frame shifted by a
+few pixels or lines, XOR a residual) when it is at most 2%, and at least 16
+bytes, larger: a player then sends only the changed bands to the display.
+
+@subsection Options
+
+@table @option
+@item format @var{integer}
+The pixel format of the frames, and the input pixel format it is encoded
+from.
+
+@table @samp
+@item auto
+Store the input pixel format as it is: @samp{rgb565be}, @samp{rgb565le},
+@samp{rgb444be}, @samp{rgb24}, @samp{gray} and @samp{monob} are stored as
+@samp{rgb565be}, @samp{rgb565le}, @samp{rgb444}, @samp{rgb888}, @samp{gray8}
+and @samp{mono}.
+@item rgb565be
+@item rgb565le
+@item rgb444
+Packed 12-bit RGB, from @samp{rgb444be}.
+@item rgb666
+RGB with 6 bits per channel in the high bits of each byte, from @samp{rgb24}.
+@item rgb888
+@item gray8
+@item gray4
+Two pixels per byte, from @samp{gray}.
+@item mono
+One bit per pixel in rows, from @samp{monob}.
+@item mono_vpage
+One bit per pixel in pages of 8 rows, as used by SSD1306-class controllers,
+from @samp{monob}.
+@end table
+
+Default value is @samp{auto}.
+
+@item compressor @var{integer}
+@table @samp
+@item stored
+@item zlib
+@end table
+
+Default value is @samp{zlib}.
+
+@item g @var{integer}
+The keyframe interval, 1 to 255. Default value is 1, every frame a keyframe.
+
+@item compression_level @var{integer}
+The zlib compression level, 0 to 9. Default value is 1.
+
+@item band_lines @var{integer}
+The band height of partial deltas, in lines: pixel rows, or pages of 8 rows
+for @samp{mono_vpage}. 0 disables partial deltas. Default value is 8.
+
+@item motion_range @var{integer}
+The range of the shift searched for each band of a partial delta, in pixels
+across; vertically the search covers the band height. 0 disables the search.
+Default value is 8.
+
+@item tolerance @var{integer}
+Keep a pixel of the previous frame, as the decoder shows it, where every
+channel of the new pixel, expanded to 8 bits, is within @var{tolerance} of
+it. Unchanged regions then become repeats and skipped bands. Default value is
+0, lossless.
+@end table
+
 @section snow
 
 @subsection Options
