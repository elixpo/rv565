+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/**
+ * @file
+ * RV565 definitions shared by the codec and the container.
+ * Specification: https://github.com/elixpo/rv565/blob/main/docs/FORMAT.md
+ *
+ * A packet is one frame record without its length field: a frame type byte
+ * (enum RV565FrameType) followed by the body. A partial delta body is the
+ * band height, the band mask, a shift per changed band and the coded
+ * residuals of the changed bands. Extradata is
+ * RV565_EXTRADATA_SIZE bytes, the pixel format, the codec and the keyframe
+ * interval, as at offsets 13-15 of a version 7 file header. Without
+ * extradata, a stream is version 6: RGB565 big-endian, zlib, keyframes only.
+ */
+
+#ifndef AVCODEC_RV565_H
+#define AVCODEC_RV565_H
+
+#include <stdint.h>
+#include <string.h>
+
+#include "libavutil/common.h"
+
+#define RV565_EXTRADATA_SIZE 3
+
+enum RV565PixelFormat {
+    RV565_PIX_RGB565BE,
+    RV565_PIX_RGB565LE,
+    RV565_PIX_RGB444,
+    RV565_PIX_RGB666,
+    RV565_PIX_RGB888,
+    RV565_PIX_GRAY8,
+    RV565_PIX_GRAY4,
+    RV565_PIX_MONO,
+    RV565_PIX_MONO_VPAGE,
+    RV565_PIX_NB,
+};
+
+enum RV565Codec {
+    RV565_CODEC_STORED,
+    RV565_CODEC_ZLIB,
+    RV565_CODEC_NB,
+};
+
+enum RV565FrameType {
+    RV565_FRAME_KEY,
+    RV565_FRAME_DELTA,
+    RV565_FRAME_REPEAT,
+    RV565_FRAME_PARTIAL,
+    RV565_FRAME_NB,
+};
+
+/**
+ * Bytes in one row of a frame; not defined for RV565_PIX_MONO_VPAGE.
+ */
+static inline int64_t ff_rv565_row_size(enum RV565PixelFormat fmt, int width)
+{
+    switch (fmt) {
+    case RV565_PIX_RGB565BE:
+    case RV565_PIX_RGB565LE: return 2LL * width;
+    case RV565_PIX_RGB444:   return (3LL * width + 1) >> 1;
+    case RV565_PIX_RGB666:
+    case RV565_PIX_RGB888:   return 3LL * width;
+    case RV565_PIX_GRAY8:    return width;
+    case RV565_PIX_GRAY4:    return (width + 1LL) >> 1;
+    case RV565_PIX_MONO:     return (width + 7LL) >> 3;
+    default:                 return 0;
+    }
+}
+
+/**
+ * Size in bytes of one decoded frame.
+ */
+static inline int64_t ff_rv565_frame_size(enum RV565PixelFormat fmt, int width, int height)
+{
+    if (fmt == RV565_PIX_MONO_VPAGE)
+        return (int64_t)width * ((height + 7LL) >> 3);
+    return ff_rv565_row_size(fmt, width) * height;
+}
+
+/**
+ * A frame as the lines that partial deltas divide into bands: pixel rows,
+ * or pages of 8 rows for RV565_PIX_MONO_VPAGE.
+ */
+static inline void ff_rv565_frame_lines(enum RV565PixelFormat fmt, int width, int height,
+                                        int *lines, int64_t *line_size)
+{
+    if (fmt == RV565_PIX_MONO_VPAGE) {
+        *lines     = (height + 7) >> 3;
+        *line_size = width;
+    } else {
+        *lines     = height;
+        *line_size = ff_rv565_row_size(fmt, width);
+    }
+}
+
+enum RV565PartialError {
+    RV565_PARTIAL_OK,
+    RV565_PARTIAL_BAND_HEIGHT,  ///< band height 0, or no body
+    RV565_PARTIAL_SHORT_MASK,   ///< the body ends inside the band mask
+    RV565_PARTIAL_NO_BAND,      ///< no band is set
+    RV565_PARTIAL_PAST_END,     ///< a band past the frame is set
+    RV565_PARTIAL_SHORT_SHIFTS, ///< the body ends inside the band shifts
+    RV565_PARTIAL_SHIFT_DY,     ///< a band is shifted by B lines or more
+};
+
+/**
+ * Parse the band height, band mask and band shifts at the start of a partial
+ * delta body.
+ *
+ * @param size        bytes available at body, at least up to the shifts
+ * @param header_size set to the size of these fields; the shifts of the
+ *                    changed bands, dx and dy signed bytes, end there
+ * @param data_size   set to the size of the changed bands together
+ * @return RV565_PARTIAL_OK or the rule the body breaks
+ */
+static inline enum RV565PartialError
+ff_rv565_parse_partial(const uint8_t *body, int64_t size, int lines, int64_t line_size,
+                       int *band_height, int *header_size, int64_t *data_size)
+{
+    int bands, mask_size, changed = 0;
+
+    if (size < 1 || !body[0])
+        return RV565_PARTIAL_BAND_HEIGHT;
+    *band_height = body[0];
+    bands        = (lines + *band_height - 1) / *band_height;
+    mask_size    = (bands + 7) >> 3;
+    if (size < 1 + mask_size)
+        return RV565_PARTIAL_SHORT_MASK;
+
+    *data_size = 0;
+    for (int b = 0; b < 8 * mask_size; b++) {
+        if (!(body[1 + (b >> 3)] >> (b & 7) & 1))
+            continue;
+        if (b >= bands)
+            return RV565_PARTIAL_PAST_END;
+        changed++;
+        *data_size += (FFMIN(lines, (b + 1) * *band_height) - b * *band_height) * line_size;
+    }
+    if (!changed)
+        return RV565_PARTIAL_NO_BAND;
+
+    *header_size = 1 + mask_size + 2 * changed;
+    if (size < *header_size)
+        return RV565_PARTIAL_SHORT_SHIFTS;
+    for (int i = 0; i < changed; i++) {
+        const int dy = (int8_t)body[1 + mask_size + 2 * i + 1];
+
+        if (FFABS(dy) >= *band_height)
+            return RV565_PARTIAL_SHIFT_DY;
+    }
+
+    return RV565_PARTIAL_OK;
+}
+
+/**
+ * Predict line y of a band of a partial delta: line y - dy of the band
+ * shifted right by dx bytes, zero where that falls outside the band or the
+ * line.
+ *
+ * @param band  the band of the previous frame, band_lines lines of line_size
+ */
+static inline void ff_rv565_predict_line(uint8_t *dst, const uint8_t *band, int band_lines,
+                                         int64_t line_size, int y, int dx, int dy)
+{
+    const int src = y - dy;
+
+    if (src < 0 || src >= band_lines || FFABS(dx) >= line_size) {
+        memset(dst, 0, line_size);
+        return;
+    }
+    band += src * line_size;
+    if (dx >= 0) {
+        memset(dst, 0, dx);
+        memcpy(dst + dx, band, line_size - dx);
+    } else {
+        memcpy(dst, band - dx, line_size + dx);
+        memset(dst + line_size + dx, 0, -dx);
+    }
+}
+
+#endif /* AVCODEC_RV565_H */
diff --git a/libavcodec/rv565dec.c b/libavcodec/rv565dec.c
new file mode 100644
index 0000000000..62f42fa24c
--- /dev/null
+++ b/libavcodec/rv565dec.c
@@ -0,0 +1,408 @@
+/*
+ * RV565 video decoder
+ *
+ * Copyright (c) 2026 Ayushman Bhattacharya
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/**
+ * @file
+ * RV565 video decoder.
+ *
+ * Frames are stored in the pixel format of a microcontroller display, either
+ * as they are or as zlib streams. A keyframe holds the frame, a delta holds
+ * the XOR of the frame with the previous one, a partial delta holds that XOR
+ * for the bands of lines that changed, and a repeat holds nothing.
+ * Deltas apply to the frame bytes in the stored layout, so the decoder keeps
+ * the previous frame in that layout and converts it to the output pixel
+ * format afterwards.
+ * Specification: https://github.com/elixpo/rv565/blob/main/docs/FORMAT.md
+ */
+
+#include "libavutil/imgutils.h"
+#include "libavutil/mem.h"
+#include "avcodec.h"
+#include "codec_internal.h"
+#include "decode.h"
+#include "rv565.h"
+#include "zlib_wrapper.h"
+
+#include <zlib.h>
+
+typedef struct RV565DecContext {
+    FFZStream zstream;
+    enum RV565PixelFormat format;
+    enum RV565Codec codec;
+    size_t frame_size;
+    uint8_t *frame;      ///< the current frame in the stored layout
+    uint8_t *body;       ///< an inflated body
+    uint8_t *band;       ///< a band of the previous frame, for shifted bands
+    /* Both buffers hold frame_size + 1 bytes, see inflate_body(). */
+    int have_reference;
+} RV565DecContext;
+
+static const enum AVPixelFormat output_formats[RV565_PIX_NB] = {
+    [RV565_PIX_RGB565BE]   = AV_PIX_FMT_RGB565BE,
+    [RV565_PIX_RGB565LE]   = AV_PIX_FMT_RGB565LE,
+    [RV565_PIX_RGB444]     = AV_PIX_FMT_RGB444BE,
+    [RV565_PIX_RGB666]     = AV_PIX_FMT_RGB24,
+    [RV565_PIX_RGB888]     = AV_PIX_FMT_RGB24,
+    [RV565_PIX_GRAY8]      = AV_PIX_FMT_GRAY8,
+    [RV565_PIX_GRAY4]      = AV_PIX_FMT_GRAY8,
+    [RV565_PIX_MONO]       = AV_PIX_FMT_MONOBLACK,
+    [RV565_PIX_MONO_VPAGE] = AV_PIX_FMT_MONOBLACK,
+};
+
+static av_cold int decode_init(AVCodecContext *avctx)
+{
+    RV565DecContext *s = avctx->priv_data;
+    int64_t frame_size;
+    int ret;
+
+    if (avctx->extradata_size >= RV565_EXTRADATA_SIZE) {
+        s->format = avctx->extradata[0];
+        s->codec  = avctx->extradata[1];
+    } else if (!avctx->extradata_size) {
+        s->format = RV565_PIX_RGB565BE;
+        s->codec  = RV565_CODEC_ZLIB;
+    } else {
+        av_log(avctx, AV_LOG_ERROR, "Invalid extradata size %d.\n",
+               avctx->extradata_size);
+        return AVERROR_INVALIDDATA;
+    }
+    if (s->format >= RV565_PIX_NB) {
+        av_log(avctx, AV_LOG_ERROR, "Unknown pixel format %d.\n", s->format);
+        return AVERROR_INVALIDDATA;
+    }
+    if (s->codec >= RV565_CODEC_NB) {
+        av_log(avctx, AV_LOG_ERROR, "Unknown codec %d.\n", s->codec);
+        return AVERROR_INVALIDDATA;
+    }
+
+    ret = av_image_check_size(avctx->width, avctx->height, 0, avctx);
+    if (ret < 0)
+        return ret;
+
+    avctx->pix_fmt = output_formats[s->format];
+
+    frame_size    = ff_rv565_frame_size(s->format, avctx->width, avctx->height);
+    s->frame_size = frame_size;
+    s->frame      = av_malloc(frame_size + 1);
+    s->body       = av_malloc(frame_size + 1);
+    s->band       = av_malloc(frame_size);
+    if (!s->frame || !s->body || !s->band)
+        return AVERROR(ENOMEM);
+
+    if (s->codec == RV565_CODEC_ZLIB)
+        return ff_inflate_init(&s->zstream, avctx);
+
+    return 0;
+}
+
+static av_cold int decode_end(AVCodecContext *avctx)
+{
+    RV565DecContext *s = avctx->priv_data;
+
+    av_freep(&s->frame);
+    av_freep(&s->body);
+    av_freep(&s->band);
+    ff_inflate_end(&s->zstream);
+
+    return 0;
+}
+
+static av_cold void decode_flush(AVCodecContext *avctx)
+{
+    RV565DecContext *s = avctx->priv_data;
+
+    s->have_reference = 0;
+}
+
+/**
+ * Inflate zlib data to exactly size bytes (at most frame_size) into s->body.
+ * The buffer has one byte more than frame_size, so data that inflates to
+ * more than expected is detected.
+ */
+static int inflate_body(AVCodecContext *avctx, const uint8_t *src, int src_size,
+                        size_t size)
+{
+    RV565DecContext *s = avctx->priv_data;
+    z_stream *const zstream = &s->zstream.zstream;
+    int zret;
+
+    if (src_size * 1032LL < size) // Asymptotic max compression of deflate
+        return AVERROR_INVALIDDATA;
+
+    zret = inflateReset(zstream);
+    if (zret != Z_OK) {
+        av_log(avctx, AV_LOG_ERROR, "Could not reset inflate: %d.\n", zret);
+        return AVERROR_EXTERNAL;
+    }
+
+    zstream->next_in   = src;
+    zstream->avail_in  = src_size;
+    zstream->next_out  = s->body;
+    zstream->avail_out = size + 1;
+
+    zret = inflate(zstream, Z_FINISH);
+    if (zret != Z_STREAM_END) {
+        av_log(avctx, AV_LOG_ERROR, "Inflate failed with return code: %d.\n", zret);
+        return AVERROR_INVALIDDATA;
+    }
+    if (zstream->total_out != size) {
+        av_log(avctx, AV_LOG_ERROR, "Data inflates to %lu bytes instead of %zu.\n",
+               zstream->total_out, size);
+        return AVERROR_INVALIDDATA;
+    }
+
+    return 0;
+}
+
+/**
+ * Decode the data of a keyframe, delta or partial delta: size bytes, stored
+ * or zlib. Sets *data to the decoded bytes.
+ */
+static int decode_data(AVCodecContext *avctx, const uint8_t *src, int src_size,
+                       size_t size, const uint8_t **data)
+{
+    RV565DecContext *s = avctx->priv_data;
+    int ret;
+
+    if (s->codec == RV565_CODEC_ZLIB) {
+        if ((ret = inflate_body(avctx, src, src_size, size)) < 0)
+            return ret;
+        *data = s->body;
+    } else {
+        if (src_size != size) {
+            av_log(avctx, AV_LOG_ERROR, "Stored data has %d bytes instead of %zu.\n",
+                   src_size, size);
+            return AVERROR_INVALIDDATA;
+        }
+        *data = src;
+    }
+
+    return 0;
+}
+
+static int decode_partial(AVCodecContext *avctx, const uint8_t *body, int body_size)
+{
+    RV565DecContext *s = avctx->priv_data;
+    const uint8_t *data, *shift;
+    int lines, bands, band_height, header_size, ret;
+    int64_t line_size, data_size;
+
+    ff_rv565_frame_lines(s->format, avctx->width, avctx->height, &lines, &line_size);
+    if (ff_rv565_parse_partial(body, body_size, lines, line_size,
+                               &band_height, &header_size, &data_size) != RV565_PARTIAL_OK) {
+        av_log(avctx, AV_LOG_ERROR, "Invalid partial delta header.\n");
+        return AVERROR_INVALIDDATA;
+    }
+
+    ret = decode_data(avctx, body + header_size, body_size - header_size,
+                      data_size, &data);
+    if (ret < 0)
+        return ret;
+
+    /* Each changed band is its prediction from the previous frame XOR its
+     * residual; the residuals are concatenated in data. */
+    bands = (lines + band_height - 1) / band_height;
+    shift = body + 1 + ((bands + 7) >> 3);
+    for (int b = 0; b < bands; b++) {
+        const int first = b * band_height;
+        const int count = FFMIN(lines, first + band_height) - first;
+        uint8_t *dst = s->frame + first * line_size;
+        const size_t size = count * line_size;
+        int dx, dy;
+
+        if (!(body[1 + (b >> 3)] >> (b & 7) & 1))
+            continue;
+        dx = (int8_t)shift[0];
+        dy = (int8_t)shift[1];
+        if (!dx && !dy) {
+            for (size_t i = 0; i < size; i++)
+                dst[i] ^= data[i];
+        } else {
+            /* The prediction reads the previous band, so keep a copy. */
+            memcpy(s->band, dst, size);
+            for (int y = 0; y < count; y++) {
+                ff_rv565_predict_line(dst, s->band, count, line_size, y, dx, dy);
+                for (int64_t j = 0; j < line_size; j++)
+                    dst[j] ^= data[j];
+                dst  += line_size;
+                data += line_size;
+            }
+            data -= size;
+        }
+        data  += size;
+        shift += 2;
+    }
+
+    return 0;
+}
+
+static void unpack_rgb444(uint8_t *dst, const uint8_t *src, int width)
+{
+    for (int x = 0; x < width; x += 2, src += 3, dst += 4) {
+        dst[0] = src[0] >> 4;
+        dst[1] = (src[0] << 4) | (src[1] >> 4);
+        if (x + 1 < width) {
+            dst[2] = src[1] & 0x0f;
+            dst[3] = src[2];
+        }
+    }
+}
+
+static void unpack_gray4(uint8_t *dst, const uint8_t *src, int width)
+{
+    for (int x = 0; x < width; x++)
+        dst[x] = (src[x >> 1] >> (x & 1 ? 0 : 4) & 0x0f) * 0x11;
+}
+
+static void convert_frame(AVCodecContext *avctx, AVFrame *frame)
+{
+    RV565DecContext *s = avctx->priv_data;
+    const int width = avctx->width, height = avctx->height;
+    const uint8_t *src = s->frame;
+    uint8_t *dst = frame->data[0];
+
+    switch (s->format) {
+    case RV565_PIX_RGB444:
+    case RV565_PIX_GRAY4: {
+        const int row_size = ff_rv565_row_size(s->format, width);
+
+        for (int y = 0; y < height; y++) {
+            if (s->format == RV565_PIX_RGB444)
+                unpack_rgb444(dst, src, width);
+            else
+                unpack_gray4(dst, src, width);
+            src += row_size;
+            dst += frame->linesize[0];
+        }
+        break;
+    }
+    case RV565_PIX_MONO_VPAGE:
+        /* Pages of 8 rows, one byte per column, least significant bit on
+         * top: transpose each page into MSB-first rows. */
+        for (int y = 0; y < height; y++) {
+            const uint8_t *page = src + (y >> 3) * (size_t)width;
+            const int bit = y & 7;
+
+            memset(dst, 0, (width + 7) >> 3);
+            for (int x = 0; x < width; x++)
+                dst[x >> 3] |= (page[x] >> bit & 1) << (7 - (x & 7));
+            dst += frame->linesize[0];
+        }
+        break;
+    default:
+        av_image_copy_plane(dst, frame->linesize[0], src,
+                            ff_rv565_row_size(s->format, width),
+                            ff_rv565_row_size(s->format, width), height);
+        break;
+    }
+}
+
+static int decode_frame(AVCodecContext *avctx, AVFrame *frame,
+                        int *got_frame, AVPacket *avpkt)
+{
+    RV565DecContext *s = avctx->priv_data;
+    const uint8_t *body = avpkt->data + 1;
+    const int body_size = avpkt->size - 1;
+    int type, ret;
+
+    if (avpkt->size < 1)
+        return AVERROR_INVALIDDATA;
+    type = avpkt->data[0];
+
+    switch (type) {
+    case RV565_FRAME_KEY:
+    case RV565_FRAME_DELTA:
+    case RV565_FRAME_PARTIAL: {
+        const uint8_t *data;
+
+        if (type != RV565_FRAME_KEY && !s->have_reference) {
+            av_log(avctx, AV_LOG_ERROR, "Delta frame without a reference frame.\n");
+            return AVERROR_INVALIDDATA;
+        }
+        /* Whatever follows depends on this frame. */
+        s->have_reference = 0;
+
+        if (type == RV565_FRAME_PARTIAL) {
+            ret = decode_partial(avctx, body, body_size);
+            if (ret < 0)
+                return ret;
+        } else {
+            ret = decode_data(avctx, body, body_size, s->frame_size, &data);
+            if (ret < 0)
+                return ret;
+            if (type == RV565_FRAME_KEY) {
+                if (data == s->body)
+                    FFSWAP(uint8_t *, s->frame, s->body);
+                else
+                    memcpy(s->frame, data, s->frame_size);
+            } else {
+                for (size_t i = 0; i < s->frame_size; i++)
+                    s->frame[i] ^= data[i];
+            }
+        }
+        s->have_reference = 1;
+        break;
+    }
+    case RV565_FRAME_REPEAT:
+        if (body_size) {
+            av_log(avctx, AV_LOG_ERROR, "Repeat frame has a body.\n");
+            return AVERROR_INVALIDDATA;
+        }
+        if (!s->have_reference) {
+            av_log(avctx, AV_LOG_ERROR, "Repeat frame without a reference frame.\n");
+            return AVERROR_INVALIDDATA;
+        }
+        break;
+    default:
+        av_log(avctx, AV_LOG_ERROR, "Unknown frame type %d.\n", type);
+        return AVERROR_INVALIDDATA;
+    }
+
+    if ((ret = ff_get_buffer(avctx, frame, 0)) < 0)
+        return ret;
+
+    convert_frame(avctx, frame);
+
+    if (type == RV565_FRAME_KEY) {
+        frame->flags    |= AV_FRAME_FLAG_KEY;
+        frame->pict_type = AV_PICTURE_TYPE_I;
+    } else {
+        frame->pict_type = AV_PICTURE_TYPE_P;
+    }
+    *got_frame = 1;
+
+    return avpkt->size;
+}
+
+const FFCodec ff_rv565_decoder = {
+    .p.name         = "rv565",
+    CODEC_LONG_NAME("RV565 (microcontroller display video)"),
+    .priv_data_size = sizeof(RV565DecContext),
+    .p.type         = AVMEDIA_TYPE_VIDEO,
+    .p.id           = AV_CODEC_ID_RV565,
+    .p.capabilities = AV_CODEC_CAP_DR1,
+    .caps_internal  = FF_CODEC_CAP_INIT_CLEANUP,
+    .init           = decode_init,
+    .close          = decode_end,
+    .flush          = decode_flush,
+    FF_CODEC_DECODE_CB(decode_frame),
+};
