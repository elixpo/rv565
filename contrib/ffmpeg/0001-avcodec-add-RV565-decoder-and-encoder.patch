index 0000000000..90c9aa01ae
--- /dev/null
+++ b/libavcodec/rv565enc.c
@@ -0,0 +1,394 @@
+/*
+ * RV565 video encoder
+ *
+ * Copyright (c) 2026 Ayushman Bhattacharya
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/**
+ * @file
+ * RV565 video encoder.
+ *
+ * Every keyframe interval starts with a keyframe. Any other frame is a repeat
+ * when it equals the previous frame, otherwise the smaller of a keyframe and
+ * a delta (the XOR with the previous frame), as in the reference encoder.
+ * Specification: https://github.com/elixpo/rv565/blob/main/docs/FORMAT.md
+ */
+
+#include "libavutil/common.h"
+#include "libavutil/imgutils.h"
+#include "libavutil/mem.h"
+#include "libavutil/opt.h"
+#include "avcodec.h"
+#include "codec_internal.h"
+#include "encode.h"
+#include "rv565.h"
+#include "zlib_wrapper.h"
+
+#include <zlib.h>
+
+#define RV565_MAX_KEYFRAME_INTERVAL 255
+
+typedef struct RV565EncContext {
+    const AVClass *class;
+    FFZStream zstream;
+    int format;             ///< enum RV565PixelFormat, or -1 for auto
+    int codec;              ///< enum RV565Codec
+    int keyframe_interval;
+    size_t frame_size;
+    size_t bound;           ///< worst-case size of an encoded body
+    uint8_t *frame;         ///< the current frame in the stored layout
+    uint8_t *previous;      ///< the previous frame in the stored layout
+    uint8_t *delta;         ///< frame XOR previous
+    uint8_t *key_body, *delta_body;
+    int64_t frame_number;
+} RV565EncContext;
+
+/* The input pixel format each RV565 pixel format is encoded from, as a list
+ * for get_supported_config(). */
+static const enum AVPixelFormat input_formats[RV565_PIX_NB][2] = {
+    [RV565_PIX_RGB565BE]   = { AV_PIX_FMT_RGB565BE, AV_PIX_FMT_NONE },
+    [RV565_PIX_RGB565LE]   = { AV_PIX_FMT_RGB565LE, AV_PIX_FMT_NONE },
+    [RV565_PIX_RGB444]     = { AV_PIX_FMT_RGB444BE, AV_PIX_FMT_NONE },
+    [RV565_PIX_RGB666]     = { AV_PIX_FMT_RGB24, AV_PIX_FMT_NONE },
+    [RV565_PIX_RGB888]     = { AV_PIX_FMT_RGB24, AV_PIX_FMT_NONE },
+    [RV565_PIX_GRAY8]      = { AV_PIX_FMT_GRAY8, AV_PIX_FMT_NONE },
+    [RV565_PIX_GRAY4]      = { AV_PIX_FMT_GRAY8, AV_PIX_FMT_NONE },
+    [RV565_PIX_MONO]       = { AV_PIX_FMT_MONOBLACK, AV_PIX_FMT_NONE },
+    [RV565_PIX_MONO_VPAGE] = { AV_PIX_FMT_MONOBLACK, AV_PIX_FMT_NONE },
+};
+
+static av_cold int encode_init(AVCodecContext *avctx)
+{
+    RV565EncContext *s = avctx->priv_data;
+    int64_t frame_size;
+    int ret;
+
+    ret = av_image_check_size(avctx->width, avctx->height, 0, avctx);
+    if (ret < 0)
+        return ret;
+    if (avctx->width > UINT16_MAX || avctx->height > UINT16_MAX) {
+        av_log(avctx, AV_LOG_ERROR, "RV565 frames are limited to %ux%u.\n",
+               UINT16_MAX, UINT16_MAX);
+        return AVERROR(EINVAL);
+    }
+
+    if (s->format < 0) {
+        /* The formats that store the input as it is. */
+        switch (avctx->pix_fmt) {
+        case AV_PIX_FMT_RGB565BE:  s->format = RV565_PIX_RGB565BE; break;
+        case AV_PIX_FMT_RGB565LE:  s->format = RV565_PIX_RGB565LE; break;
+        case AV_PIX_FMT_RGB444BE:  s->format = RV565_PIX_RGB444;   break;
+        case AV_PIX_FMT_RGB24:     s->format = RV565_PIX_RGB888;   break;
+        case AV_PIX_FMT_GRAY8:     s->format = RV565_PIX_GRAY8;    break;
+        case AV_PIX_FMT_MONOBLACK: s->format = RV565_PIX_MONO;     break;
+        default:
+            return AVERROR_BUG;
+        }
+    } else if (input_formats[s->format][0] != avctx->pix_fmt) {
+        av_log(avctx, AV_LOG_ERROR, "The selected format needs %s input.\n",
+               av_get_pix_fmt_name(input_formats[s->format][0]));
+        return AVERROR(EINVAL);
+    }
+
+    if (avctx->gop_size < 1 || avctx->gop_size > RV565_MAX_KEYFRAME_INTERVAL) {
+        av_log(avctx, AV_LOG_ERROR, "The keyframe interval (-g) must be 1-%d.\n",
+               RV565_MAX_KEYFRAME_INTERVAL);
+        return AVERROR(EINVAL);
+    }
+    s->keyframe_interval = avctx->gop_size;
+
+    avctx->extradata = av_mallocz(RV565_EXTRADATA_SIZE + AV_INPUT_BUFFER_PADDING_SIZE);
+    if (!avctx->extradata)
+        return AVERROR(ENOMEM);
+    avctx->extradata_size = RV565_EXTRADATA_SIZE;
+    avctx->extradata[0]   = s->format;
+    avctx->extradata[1]   = s->codec;
+    avctx->extradata[2]   = s->keyframe_interval;
+
+    frame_size    = ff_rv565_frame_size(s->format, avctx->width, avctx->height);
+    s->frame_size = frame_size;
+    s->frame      = av_malloc(frame_size);
+    s->previous   = av_malloc(frame_size);
+    s->delta      = av_malloc(frame_size);
+    if (!s->frame || !s->previous || !s->delta)
+        return AVERROR(ENOMEM);
+
+    if (s->codec == RV565_CODEC_ZLIB) {
+        ret = ff_deflate_init(&s->zstream,
+                              avctx->compression_level == FF_COMPRESSION_DEFAULT ?
+                              1 : av_clip(avctx->compression_level, 0, 9),
+                              avctx);
+        if (ret < 0)
+            return ret;
+        s->bound      = deflateBound(&s->zstream.zstream, s->frame_size);
+        s->key_body   = av_malloc(s->bound);
+        s->delta_body = av_malloc(s->bound);
+        if (!s->key_body || !s->delta_body)
+            return AVERROR(ENOMEM);
+    }
+
+    return 0;
+}
+
+static av_cold int encode_end(AVCodecContext *avctx)
+{
+    RV565EncContext *s = avctx->priv_data;
+
+    av_freep(&s->frame);
+    av_freep(&s->previous);
+    av_freep(&s->delta);
+    av_freep(&s->key_body);
+    av_freep(&s->delta_body);
+    ff_deflate_end(&s->zstream);
+
+    return 0;
+}
+
+/* Convert the input frame to the stored layout; unused bits are zero. */
+static void convert_frame(AVCodecContext *avctx, const AVFrame *pict)
+{
+    RV565EncContext *s = avctx->priv_data;
+    const int width = avctx->width, height = avctx->height;
+    const uint8_t *src = pict->data[0];
+    uint8_t *dst = s->frame;
+
+    if (s->format == RV565_PIX_MONO_VPAGE) {
+        /* Rows of MSB-first bits to pages of 8 rows, one byte per column,
+         * least significant bit on top. */
+        memset(dst, 0, s->frame_size);
+        for (int y = 0; y < height; y++) {
+            uint8_t *page = dst + (y >> 3) * (size_t)width;
+
+            for (int x = 0; x < width; x++)
+                page[x] |= (src[x >> 3] >> (7 - (x & 7)) & 1) << (y & 7);
+            src += pict->linesize[0];
+        }
+        return;
+    }
+
+    for (int y = 0; y < height; y++) {
+        const int row_size = ff_rv565_row_size(s->format, width);
+
+        switch (s->format) {
+        case RV565_PIX_RGB444:
+            /* 0x0R 0xGB pairs to R0G0 B0R1 G1B1. */
+            for (int x = 0; x < width; x += 2) {
+                const uint8_t *p = src + 2 * x;
+                uint8_t *q = dst + 3 * (x >> 1);
+
+                q[0] = p[0] << 4 | p[1] >> 4;
+                if (x + 1 < width) {
+                    q[1] = p[1] << 4 | (p[2] & 0x0f);
+                    q[2] = p[3];
+                } else {
+                    q[1] = p[1] << 4;
+                }
+            }
+            break;
+        case RV565_PIX_RGB666:
+            for (int i = 0; i < row_size; i++)
+                dst[i] = src[i] & 0xfc;
+            break;
+        case RV565_PIX_GRAY4:
+            memset(dst, 0, row_size);
+            for (int x = 0; x < width; x++)
+                dst[x >> 1] |= (src[x] >> 4) << (x & 1 ? 0 : 4);
+            break;
+        default:
+            memcpy(dst, src, row_size);
+            if (s->format == RV565_PIX_MONO && width & 7)
+                dst[row_size - 1] &= 0xff << (8 - (width & 7));
+            break;
+        }
+        src += pict->linesize[0];
+        dst += row_size;
+    }
+}
+
+static int deflate_body(AVCodecContext *avctx, const uint8_t *src,
+                        uint8_t *dst, size_t *size)
+{
+    RV565EncContext *s = avctx->priv_data;
+    z_stream *const zstream = &s->zstream.zstream;
+    int zret;
+
+    zret = deflateReset(zstream);
+    if (zret != Z_OK) {
+        av_log(avctx, AV_LOG_ERROR, "Could not reset deflate: %d.\n", zret);
+        return AVERROR_EXTERNAL;
+    }
+
+    zstream->next_in   = src;
+    zstream->avail_in  = s->frame_size;
+    zstream->next_out  = dst;
+    zstream->avail_out = s->bound;
+
+    zret = deflate(zstream, Z_FINISH);
+    if (zret != Z_STREAM_END) {
+        av_log(avctx, AV_LOG_ERROR, "Deflate failed with return code: %d.\n", zret);
+        return AVERROR_EXTERNAL;
+    }
+    *size = zstream->total_out;
+
+    return 0;
+}
+
+static int encode_frame(AVCodecContext *avctx, AVPacket *pkt,
+                        const AVFrame *pict, int *got_packet)
+{
+    RV565EncContext *s = avctx->priv_data;
+    enum RV565FrameType type = RV565_FRAME_KEY;
+    const uint8_t *body;
+    size_t body_size;
+    int ret;
+
+    convert_frame(avctx, pict);
+
+    if (s->frame_number % s->keyframe_interval &&
+        !memcmp(s->frame, s->previous, s->frame_size))
+        type = RV565_FRAME_REPEAT;
+
+    if (type == RV565_FRAME_REPEAT) {
+        body      = NULL;
+        body_size = 0;
+    } else if (s->codec == RV565_CODEC_STORED) {
+        /* A stored delta is never smaller than the frame. */
+        body      = s->frame;
+        body_size = s->frame_size;
+    } else {
+        ret = deflate_body(avctx, s->frame, s->key_body, &body_size);
+        if (ret < 0)
+            return ret;
+        body = s->key_body;
+
+        if (s->frame_number % s->keyframe_interval) {
+            size_t delta_size;
+
+            for (size_t i = 0; i < s->frame_size; i++)
+                s->delta[i] = s->frame[i] ^ s->previous[i];
+            ret = deflate_body(avctx, s->delta, s->delta_body, &delta_size);
+            if (ret < 0)
+                return ret;
+            if (delta_size < body_size) {
+                type      = RV565_FRAME_DELTA;
+                body      = s->delta_body;
+                body_size = delta_size;
+            }
+        }
+    }
+
+    if (body_size > INT_MAX - 1)
+        return AVERROR(ERANGE);
+    ret = ff_get_encode_buffer(avctx, pkt, body_size + 1, 0);
+    if (ret < 0)
+        return ret;
+    pkt->data[0] = type;
+    if (body_size)
+        memcpy(pkt->data + 1, body, body_size);
+    if (type == RV565_FRAME_KEY)
+        pkt->flags |= AV_PKT_FLAG_KEY;
+
+    FFSWAP(uint8_t *, s->frame, s->previous);
+    s->frame_number++;
+    *got_packet = 1;
+
+    return 0;
+}
+
+#define OFFSET(x) offsetof(RV565EncContext, x)
+#define VE AV_OPT_FLAG_VIDEO_PARAM | AV_OPT_FLAG_ENCODING_PARAM
+static const AVOption options[] = {
+    { "format", "RV565 pixel format", OFFSET(format), AV_OPT_TYPE_INT,
+      { .i64 = -1 }, -1, RV565_PIX_NB - 1, VE, .unit = "format" },
+        { "auto",       "the input pixel format, stored as it is", 0, AV_OPT_TYPE_CONST,
+          { .i64 = -1 },                   0, 0, VE, .unit = "format" },
+        { "rgb565be",   "RGB565 big-endian, from rgb565be",        0, AV_OPT_TYPE_CONST,
+          { .i64 = RV565_PIX_RGB565BE },   0, 0, VE, .unit = "format" },
+        { "rgb565le",   "RGB565 little-endian, from rgb565le",     0, AV_OPT_TYPE_CONST,
+          { .i64 = RV565_PIX_RGB565LE },   0, 0, VE, .unit = "format" },
+        { "rgb444",     "packed 12-bit RGB, from rgb444be",        0, AV_OPT_TYPE_CONST,
+          { .i64 = RV565_PIX_RGB444 },     0, 0, VE, .unit = "format" },
+        { "rgb666",     "RGB, 6 bits per channel, from rgb24",     0, AV_OPT_TYPE_CONST,
+          { .i64 = RV565_PIX_RGB666 },     0, 0, VE, .unit = "format" },
+        { "rgb888",     "RGB, 8 bits per channel, from rgb24",     0, AV_OPT_TYPE_CONST,
+          { .i64 = RV565_PIX_RGB888 },     0, 0, VE, .unit = "format" },
+        { "gray8",      "8-bit grayscale, from gray",              0, AV_OPT_TYPE_CONST,
+          { .i64 = RV565_PIX_GRAY8 },      0, 0, VE, .unit = "format" },
+        { "gray4",      "4-bit grayscale, from gray",              0, AV_OPT_TYPE_CONST,
+          { .i64 = RV565_PIX_GRAY4 },      0, 0, VE, .unit = "format" },
+        { "mono",       "1 bit per pixel in rows, from monob",     0, AV_OPT_TYPE_CONST,
+          { .i64 = RV565_PIX_MONO },       0, 0, VE, .unit = "format" },
+        { "mono_vpage", "1 bit per pixel in pages, from monob",    0, AV_OPT_TYPE_CONST,
+          { .i64 = RV565_PIX_MONO_VPAGE }, 0, 0, VE, .unit = "format" },
+    { "compressor", "frame compression", OFFSET(codec), AV_OPT_TYPE_INT,
+      { .i64 = RV565_CODEC_ZLIB }, 0, RV565_CODEC_NB - 1, VE, .unit = "compressor" },
+        { "stored", "none",         0, AV_OPT_TYPE_CONST,
+          { .i64 = RV565_CODEC_STORED }, 0, 0, VE, .unit = "compressor" },
+        { "zlib",   "zlib streams", 0, AV_OPT_TYPE_CONST,
+          { .i64 = RV565_CODEC_ZLIB },   0, 0, VE, .unit = "compressor" },
+    { NULL },
+};
+
+static const AVClass rv565enc_class = {
+    .class_name = "rv565 encoder",
+    .item_name  = av_default_item_name,
+    .option     = options,
+    .version    = LIBAVUTIL_VERSION_INT,
+};
+
+/* With a format selected, accept only the input it is encoded from. */
+static int get_supported_config(const AVCodecContext *avctx, const AVCodec *codec,
+                                enum AVCodecConfig config, unsigned flags,
+                                const void **out, int *out_num)
+{
+    if (config == AV_CODEC_CONFIG_PIX_FORMAT && avctx) {
+        const RV565EncContext *s = avctx->priv_data;
+
+        if (s && s->format >= 0) {
+            *out     = input_formats[s->format];
+            *out_num = 1;
+            return 0;
+        }
+    }
+
+    return ff_default_get_supported_config(avctx, codec, config, flags, out, out_num);
+}
+
+static const FFCodecDefault rv565_defaults[] = {
+    { "g", "1" },
+    { NULL },
+};
+
+const FFCodec ff_rv565_encoder = {
+    .p.name         = "rv565",
+    CODEC_LONG_NAME("RV565 (microcontroller display video)"),
+    .p.type         = AVMEDIA_TYPE_VIDEO,
+    .p.id           = AV_CODEC_ID_RV565,
+    .p.capabilities = AV_CODEC_CAP_DR1 | AV_CODEC_CAP_ENCODER_REORDERED_OPAQUE,
+    .priv_data_size = sizeof(RV565EncContext),
+    .p.priv_class   = &rv565enc_class,
+    .defaults       = rv565_defaults,
+    .init           = encode_init,
+    FF_CODEC_ENCODE_CB(encode_frame),
+    .close          = encode_end,
+    CODEC_PIXFMTS(AV_PIX_FMT_RGB565BE, AV_PIX_FMT_RGB565LE, AV_PIX_FMT_RGB444BE,
+                  AV_PIX_FMT_RGB24, AV_PIX_FMT_GRAY8, AV_PIX_FMT_MONOBLACK),
+    .get_supported_config = get_supported_config,
+    .caps_internal  = FF_CODEC_CAP_INIT_CLEANUP,
+};
