+/**
+ * @file
+ * RV565 demuxer.
+ *
+ * A little-endian header ("RV5", version, width, height, frames per second,
+ * flags, frame count and, in version 7, header size, pixel format, codec and
+ * keyframe interval) followed by one record per frame: a u32 length, then in
+ * version 7 a frame type byte, then the body. Version 6 records have no type
+ * byte and are all keyframes; the demuxer adds the type byte, so packets of
+ * both versions are frame records without their length.
+ * Specification: https://github.com/elixpo/rv565/blob/main/docs/FORMAT.md
+ */
+
+#include "libavutil/intreadwrite.h"
+#include "libavcodec/rv565.h"
+#include "avformat.h"
+#include "demux.h"
+#include "internal.h"
+
+#define RV565_V6_HEADER_SIZE 12
+#define RV565_V7_HEADER_SIZE 16
+#define RV565_V6_MAX_FPS     30
+#define RV565_V7_MAX_FPS     60
+
+typedef struct RV565DemuxContext {
+    int version;
+    int codec;
+    int keyframe_interval;
+    int64_t frame_size;
+    int current_frame;
+} RV565DemuxContext;
+
+/* Reading stopped before a declared frame was complete. */
+static int rv565_missing_data(AVIOContext *pb)
+{
+    return pb->error && pb->error != AVERROR_EOF ? pb->error : AVERROR_INVALIDDATA;
+}
+
+static int rv565_probe(const AVProbeData *p)
+{
+    const uint8_t *b = p->buf;
+    int header_size;
+
+    if (p->buf_size < RV565_V6_HEADER_SIZE || memcmp(b, "RV5", 3))
+        return 0;
+    if (b[3] != 6 && b[3] != 7)
+        return 0;
+    if (!AV_RL16(b + 4) || !AV_RL16(b + 6) || !b[8] || !AV_RL16(b + 10) ||
+        b[8] > (b[3] == 6 ? RV565_V6_MAX_FPS : RV565_V7_MAX_FPS))
+        return 0;
+
+    if (b[3] == 6) {
+        /* The first body is a zlib stream: CM 8 (deflate), window up to 32 KiB. */
+        if (p->buf_size <= 16)
+            return AVPROBE_SCORE_EXTENSION;
+        return (b[16] & 0x0f) == 8 && b[16] >> 4 <= 7 ? AVPROBE_SCORE_MAX : 0;
+    }
+
+    if (p->buf_size < RV565_V7_HEADER_SIZE)
+        return AVPROBE_SCORE_EXTENSION;
+    header_size = b[12];
+    if (header_size < RV565_V7_HEADER_SIZE || b[13] >= RV565_PIX_NB ||
+        b[14] >= RV565_CODEC_NB || !b[15])
+        return 0;
+    /* The first record is a keyframe. */
+    if (p->buf_size < header_size + 5)
+        return AVPROBE_SCORE_EXTENSION;
+    if (AV_RL32(b + header_size) < 2 || b[header_size + 4] != RV565_FRAME_KEY)
+        return 0;
+
+    return AVPROBE_SCORE_MAX;
+}
+
+/* Check the frame record rules that need no decoding. */
+static int rv565_check_record(AVFormatContext *s, int n, uint32_t length, int type)
+{
+    RV565DemuxContext *r = s->priv_data;
+
+    if (!length) {
+        av_log(s, AV_LOG_ERROR, "Frame %d has an empty record.\n", n);
+        return AVERROR_INVALIDDATA;
+    }
+    if (type >= RV565_FRAME_NB) {
+        av_log(s, AV_LOG_ERROR, "Frame %d has unknown type %d.\n", n, type);
+        return AVERROR_INVALIDDATA;
+    }
+    if (!(n % r->keyframe_interval) && type != RV565_FRAME_KEY) {
+        av_log(s, AV_LOG_ERROR, "Frame %d must be a keyframe.\n", n);
+        return AVERROR_INVALIDDATA;
+    }
+    if (type == RV565_FRAME_REPEAT && length != 1) {
+        av_log(s, AV_LOG_ERROR, "Repeat frame %d has a body.\n", n);
+        return AVERROR_INVALIDDATA;
+    }
+    if (type != RV565_FRAME_REPEAT && r->codec == RV565_CODEC_STORED &&
+        length - 1 != r->frame_size) {
+        av_log(s, AV_LOG_ERROR, "Stored frame %d has %"PRIu32" bytes instead of %"PRId64".\n",
+               n, length - 1, r->frame_size);
+        return AVERROR_INVALIDDATA;
+    }
+
+    return 0;
+}
+
+/* Validate and index every frame record. Lengths are stored inline, so this
+ * is one linear walk of the length table. */
+static int rv565_read_index(AVFormatContext *s, AVStream *st)
+{
+    RV565DemuxContext *r = s->priv_data;
+    AVIOContext *pb = s->pb;
+    const int64_t data_start = avio_tell(pb);
+    const int64_t size = avio_size(pb);
+    int64_t pos = data_start;
+    int ret;
+
+    for (int n = 0; n < st->nb_frames; n++) {
+        uint32_t length;
+        int type = RV565_FRAME_KEY;
+
+        if ((ret = avio_seek(pb, pos, SEEK_SET)) < 0)
+            return ret;
+        length = avio_rl32(pb);
+        if (length && r->version == 7)
+            type = avio_r8(pb);
+        if (avio_feof(pb) || (size >= 0 && pos + 4 + length > size)) {
+            av_log(s, AV_LOG_ERROR, "Frame %d is truncated.\n", n);
+            return rv565_missing_data(pb);
+        }
+        if ((ret = rv565_check_record(s, n, length, type)) < 0)
+            return ret;
+        /* The signed 30-bit index size holds at most 0x1fffffff; larger
+         * records use an unspecified size, as seeking only needs the
+         * position and timestamp. */
+        ret = av_add_index_entry(st, pos, n,
+                                 length <= 0x1ffffffbU ? length + 4 : 0, 0,
+                                 type == RV565_FRAME_KEY ? AVINDEX_KEYFRAME : 0);
+        if (ret < 0)
+            return ret;
+        pos += 4 + (int64_t)length;
+    }
+    if (size >= 0 && pos != size) {
+        av_log(s, AV_LOG_ERROR, "%"PRId64" bytes after the last frame.\n", size - pos);
+        return AVERROR_INVALIDDATA;
+    }
+
+    if ((ret = avio_seek(pb, data_start, SEEK_SET)) < 0)
+        return ret;
+
+    return 0;
+}
+
+static int rv565_read_header(AVFormatContext *s)
+{
+    RV565DemuxContext *r = s->priv_data;
+    AVIOContext *pb = s->pb;
+    AVCodecParameters *par;
+    AVStream *st;
+    int width, height, fps, flags, nb_frames, max_fps, format, ret;
+    uint32_t tag;
+
+    /* Probing may not have run (-f rv565, or the extension fallback). */
+    tag = avio_rl32(pb);
+    if ((tag & 0xffffff) != MKTAG('R', 'V', '5', 0))
+        return AVERROR_INVALIDDATA;
+    r->version = tag >> 24;
+    if (r->version != 6 && r->version != 7) {
+        av_log(s, AV_LOG_ERROR, "Unsupported RV565 version %d.\n", r->version);
+        return AVERROR_INVALIDDATA;
+    }
+
+    width     = avio_rl16(pb);
+    height    = avio_rl16(pb);
+    fps       = avio_r8(pb);
+    flags     = avio_r8(pb);
+    nb_frames = avio_rl16(pb);
+
+    if (r->version == 7) {
+        const int header_size = avio_r8(pb);
+
+        format               = avio_r8(pb);
+        r->codec             = avio_r8(pb);
+        r->keyframe_interval = avio_r8(pb);
+        max_fps              = RV565_V7_MAX_FPS;
+
+        if (header_size < RV565_V7_HEADER_SIZE) {
+            av_log(s, AV_LOG_ERROR, "Invalid header size %d.\n", header_size);
+            return AVERROR_INVALIDDATA;
+        }
+        if (format >= RV565_PIX_NB || r->codec >= RV565_CODEC_NB) {
+            av_log(s, AV_LOG_ERROR, "Unknown pixel format %d or codec %d.\n",
+                   format, r->codec);
+            return AVERROR_INVALIDDATA;
+        }
+        if (!r->keyframe_interval) {
+            av_log(s, AV_LOG_ERROR, "Invalid keyframe interval 0.\n");
+            return AVERROR_INVALIDDATA;
+        }
+        /* Fields a later revision appends to the header. */
+        avio_skip(pb, header_size - RV565_V7_HEADER_SIZE);
+    } else {
+        format               = RV565_PIX_RGB565BE;
+        r->codec             = RV565_CODEC_ZLIB;
+        r->keyframe_interval = 1;
+        max_fps              = RV565_V6_MAX_FPS;
+    }
+
+    if (pb->error && pb->error != AVERROR_EOF)
+        return pb->error;
+    if (avio_feof(pb))
+        return AVERROR_INVALIDDATA;
+
+    if (!width || !height || fps < 1 || fps > max_fps || !nb_frames) {
+        av_log(s, AV_LOG_ERROR, "Invalid header: %dx%d, %d fps, %d frames.\n",
+               width, height, fps, nb_frames);
+        return AVERROR_INVALIDDATA;
+    }
+    if (flags)
+        av_log(s, AV_LOG_VERBOSE, "Ignoring header flags 0x%02x.\n", flags);
+
+    st = avformat_new_stream(s, NULL);
+    if (!st)
+        return AVERROR(ENOMEM);
+
+    par             = st->codecpar;
+    par->codec_type = AVMEDIA_TYPE_VIDEO;
+    par->codec_id   = AV_CODEC_ID_RV565;
+    par->width      = width;
+    par->height     = height;
+    if ((ret = ff_alloc_extradata(par, RV565_EXTRADATA_SIZE)) < 0)
+        return ret;
+    par->extradata[0] = format;
+    par->extradata[1] = r->codec;
+    par->extradata[2] = r->keyframe_interval;
+    r->frame_size     = ff_rv565_frame_size(format, width, height);
+
+    st->avg_frame_rate = (AVRational){ fps, 1 };
+    st->start_time     = 0;
+    st->duration       =
+    st->nb_frames      = nb_frames;
+    avpriv_set_pts_info(st, 64, 1, fps);
+
+    if (pb->seekable & AVIO_SEEKABLE_NORMAL)
+        return rv565_read_index(s, st);
+
+    return 0;
+}
+
+static int rv565_read_packet(AVFormatContext *s, AVPacket *pkt)
+{
+    RV565DemuxContext *r = s->priv_data;
+    AVIOContext *pb = s->pb;
+    AVStream *st = s->streams[0];
+    int64_t pos;
+    uint32_t length;
+    int ret;
+
+    if (r->current_frame >= st->nb_frames) {
+        uint8_t trailing;
+
+        /* The file must end after the last declared record. */
+        ret = avio_read(pb, &trailing, 1);
+        return ret < 0 ? ret : AVERROR_INVALIDDATA;
+    }
+
+    pos    = avio_tell(pb);
+    length = avio_rl32(pb);
+    if (avio_feof(pb))
+        return rv565_missing_data(pb);
+    if (!length || length > INT_MAX - 1)
+        return AVERROR_INVALIDDATA;
+
+    if (r->version == 7) {
+        ret = av_get_packet(pb, pkt, length);
+    } else {
+        /* Add the type byte that version 6 records lack. */
+        if ((ret = av_new_packet(pkt, length + 1)) < 0)
+            return ret;
+        pkt->data[0] = RV565_FRAME_KEY;
+        ret = avio_read(pb, pkt->data + 1, length);
+    }
+    if (ret < 0)
+        return ret == AVERROR_EOF ? AVERROR_INVALIDDATA : ret;
+    if (ret != length)
+        return rv565_missing_data(pb);
+
+    ret = rv565_check_record(s, r->current_frame, pkt->size, pkt->data[0]);
+    if (ret < 0)
+        return ret;
+
+    pkt->pos          = pos;
+    pkt->stream_index = 0;
+    pkt->pts          = r->current_frame++;
+    pkt->duration     = 1;
+    if (pkt->data[0] == RV565_FRAME_KEY)
+        pkt->flags |= AV_PKT_FLAG_KEY;
+
+    return 0;
+}
+
+static int rv565_read_seek(AVFormatContext *s, int stream_index,
+                           int64_t timestamp, int flags)
+{
+    RV565DemuxContext *r = s->priv_data;
+    AVStream *st = s->streams[stream_index];
+    int index = av_index_search_timestamp(st, timestamp, flags);
+
+    /* Without AVSEEK_FLAG_ANY the index search returns a keyframe, at most
+     * keyframe_interval - 1 records from the timestamp. */
+    if (index < 0)
+        return -1;
+    if (avio_seek(s->pb, ffstream(st)->index_entries[index].pos, SEEK_SET) < 0)
+        return -1;
+
+    r->current_frame = ffstream(st)->index_entries[index].timestamp;
+
+    return 0;
+}
+
+const FFInputFormat ff_rv565_demuxer = {
+    .p.name         = "rv565",
+    .p.long_name    = NULL_IF_CONFIG_SMALL("RV565 microcontroller display video"),
+    .p.extensions   = "rv565",
+    .p.mime_type    = "video/x-rv565",
+    .p.flags        = AVFMT_NO_BYTE_SEEK | AVFMT_NOGENSEARCH,
+    .priv_data_size = sizeof(RV565DemuxContext),
+    .read_probe     = rv565_probe,
+    .read_header    = rv565_read_header,
+    .read_packet    = rv565_read_packet,
+    .read_seek      = rv565_read_seek,
+};
diff --git a/libavformat/rv565enc.c b/libavformat/rv565enc.c
new file mode 100644
index 0000000000..2a748ca5b8
--- /dev/null
+++ b/libavformat/rv565enc.c
@@ -0,0 +1,215 @@
+/*
+ * RV565 muxer
+ *
+ * Copyright (c) 2026 Ayushman Bhattacharya
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/**
+ * @file
+ * RV565 muxer.
+ * Specification: https://github.com/elixpo/rv565/blob/main/docs/FORMAT.md
+ */
+
+#include <math.h>
+
+#include "libavutil/opt.h"
+#include "libavutil/rational.h"
+#include "libavcodec/rv565.h"
+#include "avformat.h"
+#include "mux.h"
+
+#define RV565_V7_HEADER_SIZE 16
+#define RV565_V6_MAX_FPS     30
+#define RV565_V7_MAX_FPS     60
+#define RV565_MAX_FRAMES     UINT16_MAX
+
+typedef struct RV565MuxContext {
+    const AVClass *class;
+    int version;
+    int codec;
+    int keyframe_interval;
+    int64_t frame_size;
+    int64_t frame_count_pos;
+    int nb_frames;
+} RV565MuxContext;
+
+static int rv565_write_header(AVFormatContext *s)
+{
+    RV565MuxContext *r = s->priv_data;
+    AVStream *st = s->streams[0];
+    AVCodecParameters *par = st->codecpar;
+    AVRational rate = st->avg_frame_rate;
+    const int max_fps = r->version == 6 ? RV565_V6_MAX_FPS : RV565_V7_MAX_FPS;
+    int format, fps;
+
+    if (!(s->pb->seekable & AVIO_SEEKABLE_NORMAL)) {
+        av_log(s, AV_LOG_ERROR, "RV565 muxer requires seekable output.\n");
+        return AVERROR(EINVAL);
+    }
+    if (par->width < 1 || par->height < 1 ||
+        par->width > UINT16_MAX || par->height > UINT16_MAX) {
+        av_log(s, AV_LOG_ERROR, "Output dimensions exceed RV565 limits.\n");
+        return AVERROR(EINVAL);
+    }
+
+    if (par->extradata_size >= RV565_EXTRADATA_SIZE) {
+        format               = par->extradata[0];
+        r->codec             = par->extradata[1];
+        r->keyframe_interval = par->extradata[2];
+    } else if (!par->extradata_size) {
+        format               = RV565_PIX_RGB565BE;
+        r->codec             = RV565_CODEC_ZLIB;
+        r->keyframe_interval = 1;
+    } else {
+        av_log(s, AV_LOG_ERROR, "Invalid extradata size %d.\n", par->extradata_size);
+        return AVERROR_INVALIDDATA;
+    }
+    if (format >= RV565_PIX_NB || r->codec >= RV565_CODEC_NB || !r->keyframe_interval) {
+        av_log(s, AV_LOG_ERROR, "Invalid extradata.\n");
+        return AVERROR_INVALIDDATA;
+    }
+    if (r->version == 6 && (format != RV565_PIX_RGB565BE ||
+                            r->codec != RV565_CODEC_ZLIB || r->keyframe_interval != 1)) {
+        av_log(s, AV_LOG_ERROR, "Version 6 holds only zlib-compressed rgb565be keyframes.\n");
+        return AVERROR(EINVAL);
+    }
+    r->frame_size = ff_rv565_frame_size(format, par->width, par->height);
+
+    if (!rate.num || !rate.den)
+        rate = av_inv_q(st->time_base);
+    fps = rate.den ? (int)lrint(av_q2d(rate)) : 0;
+    if (fps < 1 || fps > max_fps) {
+        av_log(s, AV_LOG_ERROR, "RV565 version %d needs a frame rate of 1-%d; use -r.\n",
+               r->version, max_fps);
+        return AVERROR(EINVAL);
+    }
+    if (av_cmp_q(rate, (AVRational){ fps, 1 }))
+        av_log(s, AV_LOG_WARNING, "Frame rate %d/%d stored as %d fps.\n",
+               rate.num, rate.den, fps);
+
+    avio_write(s->pb, "RV5", 3);
+    avio_w8(s->pb, r->version);
+    avio_wl16(s->pb, par->width);
+    avio_wl16(s->pb, par->height);
+    avio_w8(s->pb, fps);
+    avio_w8(s->pb, 0);    /* flags */
+    r->frame_count_pos = avio_tell(s->pb);
+    if (r->frame_count_pos < 0)
+        return r->frame_count_pos;
+    avio_wl16(s->pb, 0);  /* frame count, written in the trailer */
+    if (r->version == 7) {
+        avio_w8(s->pb, RV565_V7_HEADER_SIZE);
+        avio_w8(s->pb, format);
+        avio_w8(s->pb, r->codec);
+        avio_w8(s->pb, r->keyframe_interval);
+    }
+
+    return 0;
+}
+
+static int rv565_write_packet(AVFormatContext *s, AVPacket *pkt)
+{
+    RV565MuxContext *r = s->priv_data;
+    int type;
+
+    if (pkt->size < 1)
+        return AVERROR_INVALIDDATA;
+    if (r->nb_frames >= RV565_MAX_FRAMES) {
+        av_log(s, AV_LOG_ERROR, "RV565 holds at most %d frames.\n", RV565_MAX_FRAMES);
+        return AVERROR(EINVAL);
+    }
+
+    /* Write only records a reader accepts. */
+    type = pkt->data[0];
+    if (type >= RV565_FRAME_NB ||
+        (!(r->nb_frames % r->keyframe_interval) && type != RV565_FRAME_KEY) ||
+        (type == RV565_FRAME_REPEAT && pkt->size != 1) ||
+        (type != RV565_FRAME_REPEAT && (r->codec == RV565_CODEC_ZLIB ? pkt->size < 2 :
+                                        pkt->size - 1 != r->frame_size))) {
+        av_log(s, AV_LOG_ERROR, "Invalid frame record for frame %d.\n", r->nb_frames);
+        return AVERROR_INVALIDDATA;
+    }
+
+    if (r->version == 6) {
+        /* Version 6 records are keyframe bodies without the type byte. */
+        avio_wl32(s->pb, pkt->size - 1);
+        avio_write(s->pb, pkt->data + 1, pkt->size - 1);
+    } else {
+        avio_wl32(s->pb, pkt->size);
+        avio_write(s->pb, pkt->data, pkt->size);
+    }
+    r->nb_frames++;
+
+    return 0;
+}
+
+static int rv565_write_trailer(AVFormatContext *s)
+{
+    RV565MuxContext *r = s->priv_data;
+    int64_t end = avio_tell(s->pb);
+    int64_t ret;
+
+    if (end < 0)
+        return end;
+    if (!r->nb_frames) {
+        av_log(s, AV_LOG_ERROR, "RV565 needs at least one frame.\n");
+        return AVERROR(EINVAL);
+    }
+
+    if ((ret = avio_seek(s->pb, r->frame_count_pos, SEEK_SET)) < 0)
+        return ret;
+    avio_wl16(s->pb, r->nb_frames);
+    if ((ret = avio_seek(s->pb, end, SEEK_SET)) < 0)
+        return ret;
+
+    return 0;
+}
+
+#define OFFSET(x) offsetof(RV565MuxContext, x)
+#define E AV_OPT_FLAG_ENCODING_PARAM
+static const AVOption options[] = {
+    { "format_version", "RV565 format version to write", OFFSET(version),
+      AV_OPT_TYPE_INT, { .i64 = 7 }, 6, 7, E },
+    { NULL },
+};
+
+static const AVClass rv565_muxer_class = {
+    .class_name = "rv565 muxer",
+    .item_name  = av_default_item_name,
+    .option     = options,
+    .version    = LIBAVUTIL_VERSION_INT,
+};
+
+const FFOutputFormat ff_rv565_muxer = {
+    .p.name           = "rv565",
+    .p.long_name      = NULL_IF_CONFIG_SMALL("RV565 microcontroller display video"),
+    .p.extensions     = "rv565",
+    .p.mime_type      = "video/x-rv565",
+    .p.audio_codec    = AV_CODEC_ID_NONE,
+    .p.video_codec    = AV_CODEC_ID_RV565,
+    .p.subtitle_codec = AV_CODEC_ID_NONE,
+    .p.priv_class     = &rv565_muxer_class,
+    .priv_data_size   = sizeof(RV565MuxContext),
+    .p.flags          = AVFMT_NOTIMESTAMPS,
+    .flags_internal   = FF_OFMT_FLAG_MAX_ONE_OF_EACH |
+                        FF_OFMT_FLAG_ONLY_DEFAULT_CODECS,
+    .write_header     = rv565_write_header,
+    .write_packet     = rv565_write_packet,
+    .write_trailer    = rv565_write_trailer,
+};
