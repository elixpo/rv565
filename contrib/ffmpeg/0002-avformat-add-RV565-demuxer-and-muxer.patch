diff --git a/libavformat/tests/rv565.c b/libavformat/tests/rv565.c
new file mode 100644
index 0000000000..fec1a82e4f
--- /dev/null
+++ b/libavformat/tests/rv565.c
@@ -0,0 +1,296 @@
+/*
+ * RV565 demuxer validation and seeking tests
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <stdio.h>
+#include <string.h>
+
+#include "libavutil/avstring.h"
+#include "libavutil/error.h"
+#include "libavutil/intreadwrite.h"
+#include "libavutil/mem.h"
+#include "libavformat/avformat.h"
+
+#define FRAMES   4
+#define INTERVAL 2
+#define BODY     6
+#define HEADER   16
+
+typedef struct Buffer {
+    const uint8_t *data;
+    int size;
+    int pos;
+    int fail_at;    /* reads at or past this offset return fail_err; 0: never */
+    int fail_err;
+} Buffer;
+
+static int read_buf(void *opaque, uint8_t *buf, int buf_size)
+{
+    Buffer *b = opaque;
+    const int end = b->fail_at ? b->fail_at : b->size;
+    int n = FFMIN(buf_size, end - b->pos);
+
+    if (n <= 0)
+        return b->fail_at ? b->fail_err : AVERROR_EOF;
+    memcpy(buf, b->data + b->pos, n);
+    b->pos += n;
+    return n;
+}
+
+static int64_t seek_buf(void *opaque, int64_t offset, int whence)
+{
+    Buffer *b = opaque;
+
+    if (whence == AVSEEK_SIZE)
+        return b->size;
+    if (whence == SEEK_CUR)
+        offset += b->pos;
+    else if (whence == SEEK_END)
+        offset += b->size;
+    if (offset < 0 || offset > b->size)
+        return AVERROR(EINVAL);
+    b->pos = offset;
+    return offset;
+}
+
+/* Frame types of the test clip: a keyframe every INTERVAL frames. */
+static const uint8_t types[FRAMES] = { 0, 1, 0, 2 };
+
+/* Offset of record n in the test clip. */
+static int record(int n)
+{
+    int pos = HEADER;
+
+    for (int i = 0; i < n; i++)
+        pos += 4 + 1 + (types[i] == 2 ? 0 : BODY);
+    return pos;
+}
+
+/* A well-formed version 7 clip: 4x2 pixels, 24 FPS, rgb565be, zlib, keyframe,
+ * delta, keyframe, repeat. The demuxer does not inflate, so the bodies need
+ * not be zlib data. */
+static int make_clip(uint8_t *p)
+{
+    int size = HEADER;
+
+    memcpy(p, "RV5\x07", 4);
+    AV_WL16(p + 4, 4);
+    AV_WL16(p + 6, 2);
+    p[8]  = 24;
+    p[9]  = 0;
+    AV_WL16(p + 10, FRAMES);
+    p[12] = HEADER;
+    p[13] = 0;          /* rgb565be */
+    p[14] = 1;          /* zlib */
+    p[15] = INTERVAL;
+    for (int i = 0; i < FRAMES; i++) {
+        const int body = types[i] == 2 ? 0 : BODY;
+
+        AV_WL32(p + size, 1 + body);
+        p[size + 4] = types[i];
+        memset(p + size + 5, 0x78 + i, body);
+        size += 5 + body;
+    }
+    return size;
+}
+
+/* The same frames as version 6: keyframes only, no type bytes. */
+static int make_clip_v6(uint8_t *p)
+{
+    int size = 12;
+
+    memcpy(p, "RV5\x06", 4);
+    AV_WL16(p + 4, 4);
+    AV_WL16(p + 6, 2);
+    p[8] = 24;
+    p[9] = 0;
+    AV_WL16(p + 10, 3);
+    for (int i = 0; i < 3; i++) {
+        AV_WL32(p + size, BODY);
+        memset(p + size + 4, 0x78 + i, BODY);
+        size += 4 + BODY;
+    }
+    return size;
+}
+
+static const char *describe(int ret)
+{
+    if (ret == AVERROR_EOF)
+        return "EOF";
+    if (ret == AVERROR_INVALIDDATA)
+        return "INVALIDDATA";
+    if (ret == AVERROR(EIO))
+        return "EIO";
+    if (ret == AVERROR(EAGAIN))
+        return "EAGAIN";
+    return ret < 0 ? "error" : "ok";
+}
+
+static int open_clip(AVFormatContext **s, AVIOContext **pb, Buffer *b, int seekable)
+{
+    uint8_t *iobuf = av_malloc(4096);
+    int ret;
+
+    if (!iobuf)
+        return AVERROR(ENOMEM);
+    *pb = avio_alloc_context(iobuf, 4096, 0, b, read_buf, NULL, seekable ? seek_buf : NULL);
+    if (!*pb) {
+        av_free(iobuf);
+        return AVERROR(ENOMEM);
+    }
+    *s = avformat_alloc_context();
+    if (!*s)
+        return AVERROR(ENOMEM);
+    (*s)->pb = *pb;
+    ret = avformat_open_input(s, NULL, av_find_input_format("rv565"), NULL);
+    return ret;
+}
+
+static void close_clip(AVFormatContext **s, AVIOContext **pb)
+{
+    avformat_close_input(s);
+    if (*pb)
+        av_freep(&(*pb)->buffer);
+    avio_context_free(pb);
+}
+
+/* Read every packet and report how the stream ended, with the frame type
+ * byte of each packet and K for packets flagged as keyframes. Seekable input
+ * is validated when it is opened; streamed input packet by packet. With
+ * fail_at, reads from that offset on fail with fail_err. */
+static void run_io(const char *name, const uint8_t *data, int size, int seekable,
+                   int fail_at, int fail_err)
+{
+    Buffer b = { data, size, 0, fail_at, fail_err };
+    AVFormatContext *s = NULL;
+    AVIOContext *pb = NULL;
+    AVPacket *pkt = av_packet_alloc();
+    char frames[64] = "";
+    int packets = 0, ret;
+
+    if (!pkt)
+        return;
+    ret = open_clip(&s, &pb, &b, seekable);
+    if (ret < 0) {
+        printf("%-30s %-8s open %s\n", name, seekable ? "seekable" : "streamed",
+               describe(ret));
+    } else {
+        while ((ret = av_read_frame(s, pkt)) >= 0) {
+            if (packets < 20) {
+                av_strlcatf(frames, sizeof(frames), " %d%s", pkt->data[0],
+                            pkt->flags & AV_PKT_FLAG_KEY ? "K" : "");
+            }
+            packets++;
+            av_packet_unref(pkt);
+        }
+        printf("%-30s %-8s packets %d (%s ), then %s\n", name,
+               seekable ? "seekable" : "streamed", packets, frames, describe(ret));
+    }
+    av_packet_free(&pkt);
+    close_clip(&s, &pb);
+}
+
+static void run(const char *name, const uint8_t *data, int size)
+{
+    run_io(name, data, size, 1, 0, 0);
+    run_io(name, data, size, 0, 0, 0);
+}
+
+static void run_seek(const uint8_t *data, int size)
+{
+    Buffer b = { data, size, 0, 0, 0 };
+    AVFormatContext *s = NULL;
+    AVIOContext *pb = NULL;
+    AVPacket *pkt = av_packet_alloc();
+    int ret;
+
+    if (!pkt)
+        return;
+    if (open_clip(&s, &pb, &b, 1) >= 0) {
+        ret = av_seek_frame(s, 0, HEADER, AVSEEK_FLAG_BYTE);
+        printf("%-30s byte seek %s\n", "seek", ret < 0 ? "rejected" : "accepted");
+        /* Every frame seeks to the keyframe at or before it. */
+        for (int ts = 0; ts < FRAMES; ts++) {
+            ret = av_seek_frame(s, 0, ts, AVSEEK_FLAG_BACKWARD);
+            if (ret >= 0)
+                ret = av_read_frame(s, pkt);
+            printf("%-30s to %d: %s, next pts %"PRId64" type %d%s\n", "seek", ts,
+                   describe(ret), ret < 0 ? (int64_t)-1 : pkt->pts,
+                   ret < 0 ? -1 : pkt->data[0],
+                   ret >= 0 && pkt->flags & AV_PKT_FLAG_KEY ? " key" : "");
+            av_packet_unref(pkt);
+        }
+    }
+    av_packet_free(&pkt);
+    close_clip(&s, &pb);
+}
+
+int main(void)
+{
+    uint8_t clip[HEADER + FRAMES * (5 + BODY) + 8];
+    uint8_t buf[sizeof(clip)];
+    const int size   = make_clip(clip);
+    const int second = record(1);
+    int size6;
+
+    run("valid", clip, size);
+    run("truncated after record", clip, second);
+    run("partial length field", clip, second + 2);
+    run("body absent", clip, second + 5);
+    run("body partial", clip, second + 5 + BODY / 2);
+
+    memcpy(buf, clip, size);
+    memcpy(buf + size, "JUNK", 4);
+    run("trailing bytes", buf, size + 4);
+
+#define CORRUPT(name, offset, value) do { \
+        memcpy(buf, clip, size);             \
+        buf[offset] = value;                 \
+        run(name, buf, size);                \
+    } while (0)
+
+    CORRUPT("bad magic",            0,             'B');
+    CORRUPT("version 8",            3,             8);
+    CORRUPT("frame rate 61",        8,             61);
+    CORRUPT("header size 15",       12,            15);
+    CORRUPT("pixel format 9",       13,            9);
+    CORRUPT("codec 2",              14,            2);
+    CORRUPT("keyframe interval 0",  15,            0);
+    CORRUPT("frame type 3",         record(1) + 4, 3);
+    CORRUPT("first frame delta",    record(0) + 4, 1);
+    CORRUPT("missing keyframe",     record(2) + 4, 1);
+    CORRUPT("empty record",         record(1),     0);
+
+    /* A repeat with a body: frame 1 becomes a repeat of six bytes. */
+    CORRUPT("repeat with body",     record(1) + 4, 2);
+
+    /* Stored frames must be exactly 4 * 2 * 2 bytes. */
+    CORRUPT("stored, wrong size",   14,            0);
+
+    size6 = make_clip_v6(buf);
+    run("version 6", buf, size6);
+    buf[8] = 31;
+    run("version 6, frame rate 31", buf, size6);
+
+    run_io("EIO inside body", clip, size, 0, second + 5 + 3, AVERROR(EIO));
+    run_io("EAGAIN at end", clip, size, 0, size, AVERROR(EAGAIN));
+
+    run_seek(clip, size);
+    return 0;
+}
