diff --git a/tests/fate/rv565.mak b/tests/fate/rv565.mak
new file mode 100644
index 0000000000..aa9e174281
--- /dev/null
+++ b/tests/fate/rv565.mak
@@ -0,0 +1,52 @@
+# Encode a clip whose frames repeat (testsrc at 6 fps resampled to 12 fps)
+# to every RV565 pixel format, then decode it. Stored frames keep the
+# reference independent of the zlib implementation; 21x13 pads the rows of
+# rgb444, gray4 and mono and the last page of mono_vpage.
+RV565_SRC = testsrc=s=21x13:r=6:d=2,fps=12
+RV565_PROBE = -show_entries frame=key_frame,pict_type -of compact=p=0:nk=1
+
+define FATE_RV565_ENC_TEST
+FATE_RV565_ENC += fate-rv565-enc-$(1)
+fate-rv565-enc-$(1): CMD = transcode lavfi "$$(RV565_SRC),scale,format=$(2)" rv565 \
+    "-c:v rv565 -format $(1) -compressor stored -g 4" "" "$$(RV565_PROBE)"
+endef
+
+$(eval $(call FATE_RV565_ENC_TEST,rgb565be,rgb565be))
+$(eval $(call FATE_RV565_ENC_TEST,rgb565le,rgb565le))
+$(eval $(call FATE_RV565_ENC_TEST,rgb444,rgb444be))
+$(eval $(call FATE_RV565_ENC_TEST,rgb666,rgb24))
+$(eval $(call FATE_RV565_ENC_TEST,rgb888,rgb24))
+$(eval $(call FATE_RV565_ENC_TEST,gray8,gray))
+$(eval $(call FATE_RV565_ENC_TEST,gray4,gray))
+$(eval $(call FATE_RV565_ENC_TEST,mono,monob))
+$(eval $(call FATE_RV565_ENC_TEST,mono_vpage,monob))
+
+# Keyframes, deltas and repeats with zlib.
+FATE_RV565_ENC += fate-rv565-enc-delta
+fate-rv565-enc-delta: CMD = transcode lavfi "$(RV565_SRC),scale,format=rgb565be" rv565 \
+    "-c:v rv565 -g 8" "" "$(RV565_PROBE)"
+
+# Version 6 output.
+FATE_RV565_ENC += fate-rv565-enc-v6
+fate-rv565-enc-v6: CMD = transcode lavfi "$(RV565_SRC),scale,format=rgb565be" rv565 \
+    "-c:v rv565 -compression_level 0 -format_version 6" "" "$(RV565_PROBE)"
+
+FATE_RV565-$(call TRANSCODE, RV565, RV565, LAVFI_INDEV TESTSRC_FILTER FPS_FILTER \
+                             SCALE_FILTER FORMAT_FILTER) += $(FATE_RV565_ENC)
+
+# Conformance vectors of the RV565 specification (tests/data/v7 in
+# https://github.com/elixpo/rv565), 21x13 at 12 fps, and its version 6 test
+# pattern.
+define FATE_RV565_DEC_TEST
+FATE_RV565_SAMPLES-$(call FRAMECRC, RV565, RV565) += fate-rv565-$(1)
+fate-rv565-$(1): CMD = framecrc -i $$(TARGET_SAMPLES)/rv565/$(1).rv565 -c:v rawvideo
+endef
+
+$(foreach V,rgb565be_zlib_forced_delta_k8 rgb565le_stored_k3 rgb444_zlib_k4 \
+            rgb666_stored_k3 rgb888_zlib_k4 gray8_stored_k3 gray4_zlib_k4 \
+            mono_zlib_forced_delta_k8 mono_vpage_zlib_k4 testpattern_v6, \
+            $(eval $(call FATE_RV565_DEC_TEST,$(V))))
+
+FATE_FFMPEG_FFPROBE += $(FATE_RV565-yes)
+FATE_SAMPLES_FFMPEG += $(FATE_RV565_SAMPLES-yes)
+fate-rv565: $(FATE_RV565-yes) $(FATE_RV565_SAMPLES-yes)
